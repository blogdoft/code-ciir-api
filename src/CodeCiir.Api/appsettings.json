{
  "AllowedHosts": "*",
  "ApplicationName": "CodeCiir.Api",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {@t, level: @l, message: @m, @x, @tr, @sp, ..@p} }\n"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "Embeddings": {
    "Provider": "Ollama",
    "BaseUrl": "http://192.168.1.212:11434",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "Model": "bge-m3",
    "Dimensions": 1024
  },
  "Reranking": {
    "Provider": "Ollama",
    "Model": "qwen2.5:7b-instruct",
    "BaseUrl": "http://192.168.1.212:11434",
    "ApiKey": "",
    "TimeoutSeconds": 120,
    "CandidatePoolSize": 25,
    "MaxConcurrency": 6
  },
  "Keycloak": {
    "Enabled": false,
    "Authority": "",
    "Audience": "",
    "ClientId": "",
    "RequireHttpsMetadata": true
  }
}